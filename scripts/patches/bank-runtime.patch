+++ b/.runtime/bank/backend/internal/excelio/header_regression_test.go
@@ -0,0 +1,14 @@
+package excelio
+
+import "testing"
+
+func TestBankIdentifierHeaderPrecedence(t *testing.T) {
+    for _, h := range []string{"bank_user_id", "bankUserId", "bank-id"} {
+        if got := headerToField(normalizeHeader(h)); got != "bank_user_id" {
+            t.Fatalf("%s mapped to %s", h, got)
+        }
+    }
+    if headerToField(normalizeHeader("id_card")) != "id_card" {
+        t.Fatal("identity card mapping changed")
+    }
+}
